FROM node:22-alpine
WORKDIR /app
# 企微机器人测试通道专用镜像（独立于业务 server.js 部署，仅 wecom-bot.js + core + 文档库）
COPY package.json ./
RUN npm install --omit=dev --no-fund --no-audit --registry=https://registry.npmmirror.com \
 && npm install --omit=dev --no-fund --no-audit --no-save --registry=https://registry.npmmirror.com @wecom/aibot-node-sdk
COPY envload.js net.js wecom-bot.js ./
COPY core ./core
COPY .env ./
COPY docs ./docs
ENV PORT=80 NODE_ENV=production
CMD ["node", "wecom-bot.js"]
